import { create } from 'zustand';
import { persist } from 'zustand/middleware';
import type {

  JourneyState,
  Phase,
  Month,
  Goal,
  Task,
  Major,
  Skill,
  JournalEntry,
  BudgetItem,
  Budget,
  DocumentItem,
  Achievement,
  MajorDecisionResponse,
  TaskStatus,
  SkillStatus,
  DocumentStatus,
  JournalCategory,
}
 from '../types';
import {
  INITIAL_PHASES,
  INITIAL_MAJORS,
  INITIAL_SKILLS,
  INITIAL_DOCUMENTS,
  INITIAL_BUDGET,
  INITIAL_ACHIEVEMENTS,
} from './Speed data';

export const useJourneyStore = create<JourneyState>()(
  persist(
    (set, get) => ({
      // ============ META ============
      myWhy: 'I want to understand what kind of person and scientist I want to become, and I want to give myself a real chance to study what I genuinely care about.',

      setMyWhy: (text: string) =>
        set({ myWhy: text }),

      // ============ ROADMAP ============
      phases: INITIAL_PHASES,

      getPhase: (phaseId: string) => {
        const state = get();
        return state.phases.find((p) => p.id === phaseId);
      },

      getMonth: (monthId: string) => {
        const state = get();
        for (const phase of state.phases) {
          const month = phase.months.find((m) => m.id === monthId);
          if (month) return month;
        }
        return undefined;
      },

      getGoal: (goalId: string) => {
        const state = get();
        for (const phase of state.phases) {
          for (const month of phase.months) {
            const goal = month.goals.find((g) => g.id === goalId);
            if (goal) return goal;
          }
        }
        return undefined;
      },

      getTask: (taskId: string) => {
        const state = get();
        for (const phase of state.phases) {
          for (const month of phase.months) {
            for (const goal of month.goals) {
              const task = goal.tasks.find((t) => t.id === taskId);
              if (task) return task;
            }
          }
        }
        return undefined;
      },

      toggleTask: (taskId: string) =>
        set((state) => {
          const newPhases = state.phases.map((phase) => ({
            ...phase,
            months: phase.months.map((month) => ({
              ...month,
              goals: month.goals.map((goal) => {
                const updatedGoal = {
                  ...goal,
                  tasks: goal.tasks.map((task) => {
                    if (task.id === taskId) {
                      const wasCompleted = task.status === 'Completed';
                      const newStatus: TaskStatus = wasCompleted ? 'Not Started' : 'Completed';

                      // Handle major reward
                      if (task.majorReward && !wasCompleted) {
                        const majorId = task.majorReward.majorId;
                        set((s) => ({
                          majors: s.majors.map((m) =>
                            m.id === majorId
                              ? {
                                  ...m,
                                  confidenceScore: Math.min(
                                    10,
                                    Math.max(0, m.confidenceScore + task.majorReward!.confidenceAmount)
                                  ),
                                }
                              : m
                          ),
                        }));
                      } else if (task.majorReward && wasCompleted) {
                        const majorId = task.majorReward.majorId;
                        set((s) => ({
                          majors: s.majors.map((m) =>
                            m.id === majorId
                              ? {
                                  ...m,
                                  confidenceScore: Math.min(
                                    10,
                                    Math.max(0, m.confidenceScore - task.majorReward!.confidenceAmount)
                                  ),
                                }
                              : m
                          ),
                        }));
                      }

                      return { ...task, status: newStatus };
                    }
                    return task;
                  }),
                };

                // Recalculate goal progress
                const completedTasks = updatedGoal.tasks.filter((t) => t.status === 'Completed').length;
                updatedGoal.progress = Math.round((completedTasks / updatedGoal.tasks.length) * 100);

                return updatedGoal;
              }),
            })),
          }));

          return { phases: newPhases };
        }),

      addTask: (goalId: string, task: Omit<Task, 'id' | 'goalId' | 'createdAt'>) =>
        set((state) => {
          const newPhases = state.phases.map((phase) => ({
            ...phase,
            months: phase.months.map((month) => ({
              ...month,
              goals: month.goals.map((goal) => {
                if (goal.id === goalId) {
                  return {
                    ...goal,
                    tasks: [
                      ...goal.tasks,
                      {
                        ...task,
                        id: `task-${Date.now()}`,
                        goalId,
                        createdAt: new Date().toISOString(),
                      },
                    ],
                  };
                }
                return goal;
              }),
            })),
          }));
          return { phases: newPhases };
        }),

      updateTask: (taskId: string, updates: Partial<Task>) =>
        set((state) => {
          const newPhases = state.phases.map((phase) => ({
            ...phase,
            months: phase.months.map((month) => ({
              ...month,
              goals: month.goals.map((goal) => ({
                ...goal,
                tasks: goal.tasks.map((task) => (task.id === taskId ? { ...task, ...updates } : task)),
              })),
            })),
          }));
          return { phases: newPhases };
        }),

      deleteTask: (taskId: string) =>
        set((state) => {
          const newPhases = state.phases.map((phase) => ({
            ...phase,
            months: phase.months.map((month) => ({
              ...month,
              goals: month.goals.map((goal) => ({
                ...goal,
                tasks: goal.tasks.filter((t) => t.id !== taskId),
              })),
            })),
          }));
          return { phases: newPhases };
        }),

      // ============ MAJORS ============
      majors: INITIAL_MAJORS,

      reorderMajors: (oldIndex: number, newIndex: number) =>
        set((state) => {
          const newMajors = [...state.majors];
          const [movedMajor] = newMajors.splice(oldIndex, 1);
          if (!movedMajor) return state;
          newMajors.splice(newIndex, 0, movedMajor);
          return { majors: newMajors };
        }),

      updateMajorScore: (majorId: string, type: 'interest' | 'confidence', score: number) =>
        set((state) => ({
          majors: state.majors.map((major) =>
            major.id === majorId
              ? {
                  ...major,
                  [type === 'interest' ? 'interestScore' : 'confidenceScore']: Math.min(10, Math.max(0, score)),
                }
              : major
          ),
        })),

      getMajorConfidenceFromTasks: (majorId: string) => {
        const state = get();
        let totalReward = 0;

        for (const phase of state.phases) {
          for (const month of phase.months) {
            for (const goal of month.goals) {
              for (const task of goal.tasks) {
                if (task.status === 'Completed' && task.majorReward?.majorId === majorId) {
                  totalReward += task.majorReward.confidenceAmount;
                }
              }
            }
          }
        }

        return Math.min(10, totalReward);
      },

      // ============ SKILLS ============
      skills: INITIAL_SKILLS,

      updateSkillStatus: (skillId: string, status: SkillStatus) =>
        set((state) => {
          const skills = [...state.skills];
          const skillIndex = skills.findIndex((s) => s.id === skillId);

          if (skillIndex === -1) return state;

          const currentSkill = skills[skillIndex];
          skills[skillIndex] = {
            ...currentSkill,
            status,
            unlockedAt: status === 'not-started' ? new Date().toISOString() : currentSkill.unlockedAt,
            completedAt: status === 'completed' ? new Date().toISOString() : currentSkill.completedAt,
          };

          if (status === 'completed') {
            const nextSkillIndex = skills.findIndex(
              (skill, index) =>
                index > skillIndex &&
                skill.track === currentSkill.track &&
                skill.category === currentSkill.category &&
                skill.status === 'locked'
            );

            if (nextSkillIndex !== -1) {
              skills[nextSkillIndex] = {
                ...skills[nextSkillIndex],
                status: 'not-started',
              };
            }
          }

          return { skills };
        }),

      // ============ JOURNAL ============
      journalEntries: [],

      addJournalEntry: (entry: Omit<JournalEntry, 'id' | 'createdAt'>) =>
        set((state) => ({
          journalEntries: [
            ...state.journalEntries,
            {
              ...entry,
              id: `journal-${Date.now()}`,
              createdAt: new Date().toISOString(),
            },
          ],
        })),

      updateJournalEntry: (entryId: string, updates: Partial<JournalEntry>) =>
        set((state) => ({
          journalEntries: state.journalEntries.map((entry) =>
            entry.id === entryId ? { ...entry, ...updates } : entry
          ),
        })),

      deleteJournalEntry: (entryId: string) =>
        set((state) => ({
          journalEntries: state.journalEntries.filter((entry) => entry.id !== entryId),
        })),

      getJournalByCategory: (category: JournalCategory) => {
        const state = get();
        return state.journalEntries.filter((entry) => entry.category === category);
      },

      // ============ BUDGET ============
      budget: INITIAL_BUDGET,

      addBudgetItem: (item: BudgetItem) =>
        set((state) => ({
          budget: {
            ...state.budget,
            items: [...state.budget.items, item],
          },
        })),

      removeBudgetItem: (itemId: string) =>
        set((state) => ({
          budget: {
            ...state.budget,
            items: state.budget.items.filter((item) => item.id !== itemId),
          },
        })),

      updateBudgetItem: (itemId: string, updates: Partial<BudgetItem>) =>
        set((state) => ({
          budget: {
            ...state.budget,
            items: state.budget.items.map((item) =>
              item.id === itemId ? { ...item, ...updates } : item
            ),
          },
        })),

      setBudgetTarget: (amount: number) =>
        set((state) => ({
          budget: {
            ...state.budget,
            targetAmount: amount,
          },
        })),

      setCurrentSavings: (amount: number) =>
        set((state) => ({
          budget: {
            ...state.budget,
            currentSavings: amount,
          },
        })),

      // ============ DOCUMENTS ============
      documents: INITIAL_DOCUMENTS,

      updateDocumentStatus: (documentId: string, status: DocumentStatus) =>
        set((state) => ({
          documents: state.documents.map((doc) =>
            doc.id === documentId ? { ...doc, status } : doc
          ),
        })),

      addDocument: (doc: Omit<DocumentItem, 'id'>) =>
        set((state) => ({
          documents: [
            ...state.documents,
            {
              ...doc,
              id: `doc-${Date.now()}`,
            },
          ],
        })),

      deleteDocument: (documentId: string) =>
        set((state) => ({
          documents: state.documents.filter((doc) => doc.id !== documentId),
        })),

      // ============ ACHIEVEMENTS ============
      achievements: INITIAL_ACHIEVEMENTS,

      unlockAchievement: (achievementId: string) =>
        set((state) => ({
          achievements: state.achievements.map((achievement) =>
            achievement.id === achievementId
              ? { ...achievement, unlockedAt: new Date().toISOString() }
              : achievement
          ),
        })),

      // ============ MAJOR DECISION ============
      majorDecisions: [],

      addMajorDecisionResponse: (response: MajorDecisionResponse) =>
        set((state) => ({
          majorDecisions: [...state.majorDecisions, response],
        })),

      // ============ PROGRESS & STATS ============
      getOverallProgress: () => {
        const state = get();
        const allTasks: Task[] = [];

        for (const phase of state.phases) {
          for (const month of phase.months) {
            for (const goal of month.goals) {
              allTasks.push(...goal.tasks);
            }
          }
        }

        if (allTasks.length === 0) return 0;
        const completedCount = allTasks.filter((t) => t.status === 'Completed').length;
        return Math.round((completedCount / allTasks.length) * 100);
      },

      getPhaseProgress: (phaseId: string) => {
        const state = get();
        const phase = state.phases.find((p) => p.id === phaseId);
        if (!phase) return 0;

        const allTasks: Task[] = [];
        for (const month of phase.months) {
          for (const goal of month.goals) {
            allTasks.push(...goal.tasks);
          }
        }

        if (allTasks.length === 0) return 0;
        const completedCount = allTasks.filter((t) => t.status === 'Completed').length;
        return Math.round((completedCount / allTasks.length) * 100);
      },

      getCompletedTaskCount: () => {
        const state = get();
        let count = 0;
        for (const phase of state.phases) {
          for (const month of phase.months) {
            for (const goal of month.goals) {
              count += goal.tasks.filter((t) => t.status === 'Completed').length;
            }
          }
        }
        return count;
      },

      getTotalTaskCount: () => {
        const state = get();
        let count = 0;
        for (const phase of state.phases) {
          for (const month of phase.months) {
            for (const goal of month.goals) {
              count += goal.tasks.length;
            }
          }
        }
        return count;
      },

      getCurrentPhase: () => {
        const state = get();
        return state.phases.find((p) => p.status === 'In Progress') || state.phases[0];
      },

      getNextTask: () => {
        const state = get();
        for (const phase of state.phases) {
          for (const month of phase.months) {
            for (const goal of month.goals) {
              const nextTask = goal.tasks.find((t) => t.status === 'Not Started');
              if (nextTask) return nextTask;
            }
          }
        }
        return undefined;
      },

      // ============ DATA MANAGEMENT ============
      exportData: () => {
        const state = get();
        return JSON.stringify(
          {
            phases: state.phases,
            majors: state.majors,
            skills: state.skills,
            journalEntries: state.journalEntries,
            budget: state.budget,
            documents: state.documents,
            achievements: state.achievements,
            majorDecisions: state.majorDecisions,
            myWhy: state.myWhy,
          },
          null,
          2
        );
      },

      importData: (jsonString: string) => {
        try {
          const data = JSON.parse(jsonString);
          set({
            phases: data.phases || INITIAL_PHASES,
            majors: data.majors || INITIAL_MAJORS,
            skills: data.skills || INITIAL_SKILLS,
            journalEntries: data.journalEntries || [],
            budget: data.budget || INITIAL_BUDGET,
            documents: data.documents || INITIAL_DOCUMENTS,
            achievements: data.achievements || INITIAL_ACHIEVEMENTS,
            majorDecisions: data.majorDecisions || [],
            myWhy: data.myWhy || get().myWhy,
          });
          return true;
        } catch (error) {
          console.error('Failed to import data:', error);
          return false;
        }
      },

      resetData: () =>
        set({
          phases: INITIAL_PHASES,
          majors: INITIAL_MAJORS,
          skills: INITIAL_SKILLS,
          journalEntries: [],
          budget: INITIAL_BUDGET,
          documents: INITIAL_DOCUMENTS,
          achievements: INITIAL_ACHIEVEMENTS,
          majorDecisions: [],
          myWhy: 'I want to understand what kind of person and scientist I want to become, and I want to give myself a real chance to study what I genuinely care about.',
        }),
    }),
    {
      name: 'k-roadmap-storage-v2',
    }
  )
);